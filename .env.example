EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public Mapbox access token (pk.*) — runtime map tiles/styles. Safe in the client.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Optional: secret downloads token (sk.*) only for CocoaPods/Gradle Mapbox SDK install.
# Set as RNMapboxMapsDownloadToken in app.json locally — never commit secrets.
